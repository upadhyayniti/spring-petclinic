# Use a secure, distroless Java Runtime Environment image from Chainguard
FROM cgr.dev/chainguard/jre:latest

WORKDIR /app

# Copy the pre-compiled JAR from your local target directory into the container
# Note: Spring PetClinic naming conventions often generate 'spring-petclinic-[version].jar'
COPY target/spring-petclinic-*.jar app.jar

# Expose the default Spring Boot port
EXPOSE 8080

# Run the application securely as a non-root user (enforced by the base image)
ENTRYPOINT ["java", "-jar", "app.jar"]
